@model List<Hekim>
@{
    ViewData["Title"] = "Veteriner Hekim Yönetimi";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h3 class="mb-0 text-success fw-bold">Veteriner Hekimler</h3>
        <small class="text-muted">Klinikte görev yapan hekimlerin uzmanlık, mesai ve hizmet tanımlamaları</small>
    </div>
    <a asp-action="Ekle" class="btn btn-success">+ Yeni Hekim Ekle</a>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <table class="table table-striped table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Hekim Adı Soyadı</th>
                    <th>Uzmanlık Alanı</th>
                    <th>Mesai Saatleri</th>
                    <th>Verebildiği Hizmetler</th>
                    <th>Giriş Hesabı</th>
                    <th class="text-end">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="text-center py-4 text-muted">Henüz tanımlı veteriner hekim bulunmuyor.</td>
                    </tr>
                }
                else
                {
                    @foreach (var h in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@h.AdSoyad</td>
                            <td>@h.UzmanlikAlani</td>
                            <td>
                                <span class="badge bg-secondary">
                                    @h.MesaiBaslangic.ToString("HH:mm") - @h.MesaiBitis.ToString("HH:mm")
                                </span>
                            </td>
                            <td>
                                @foreach (var hizmet in h.VerdigiHizmetler)
                                {
                                    <span class="badge bg-light text-dark border me-1">@hizmet.HizmetAdi</span>
                                }
                            </td>
                            <td class="small text-muted">@(h.Kullanici?.Email ?? "-")</td>
                            <td class="text-end">
                                <a asp-action="Detay" asp-route-id="@h.Id" class="btn btn-sm btn-outline-secondary">Detay</a>
                                <a asp-action="Duzenle" asp-route-id="@h.Id" class="btn btn-sm btn-outline-primary">Düzenle</a>
                                <a asp-action="Sil" asp-route-id="@h.Id" class="btn btn-sm btn-outline-danger">Sil</a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
