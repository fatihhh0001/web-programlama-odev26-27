@model KlinikHizmet
@{
    ViewData["Title"] = "Yeni Hizmet Ekle";
}

<div class="row justify-content-center mt-3">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0">Yeni Klinik Hizmeti Tanımla</h5>
            </div>
            <div class="card-body">
                <form asp-action="Ekle" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="HizmetAdi" class="form-label fw-semibold"></label>
                        <input asp-for="HizmetAdi" class="form-control" placeholder="Örn: Genel Muayene, Kuduz Aşısı" />
                        <span asp-validation-for="HizmetAdi" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Aciklama" class="form-label fw-semibold"></label>
                        <textarea asp-for="Aciklama" class="form-control" rows="3" placeholder="Hizmet hakkında kısa bilgi"></textarea>
                        <span asp-validation-for="Aciklama" class="text-danger small"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="SureDakika" class="form-label fw-semibold"></label>
                            <input asp-for="SureDakika" type="number" min="10" max="360" class="form-control" />
                            <span asp-validation-for="SureDakika" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Ucret" class="form-label fw-semibold"></label>
                            <input asp-for="Ucret" type="number" step="0.01" min="0" class="form-control" />
                            <span asp-validation-for="Ucret" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between mt-2">
                        <a asp-action="Index" class="btn btn-outline-secondary">İptal</a>
                        <button type="submit" class="btn btn-success">Hizmeti Kaydet</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
