@model List<KlinikHizmet>
@{
    ViewData["Title"] = "Klinik Hizmet Yönetimi";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h3 class="mb-0 text-success fw-bold">Klinik Hizmetleri</h3>
        <small class="text-muted">Kliniğimizde sunulan hizmetlerin süre ve ücret tanımlamaları</small>
    </div>
    <a asp-action="Ekle" class="btn btn-success">+ Yeni Hizmet Ekle</a>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <table class="table table-striped table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Hizmet Adı</th>
                    <th>Açıklama</th>
                    <th>Süre</th>
                    <th>Ücret</th>
                    <th>Yetkili Hekim</th>
                    <th class="text-end">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="text-center py-4 text-muted">Henüz tanımlı bir klinik hizmeti bulunmuyor.</td>
                    </tr>
                }
                else
                {
                    @foreach (var h in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@h.HizmetAdi</td>
                            <td class="text-muted small">@(string.IsNullOrEmpty(h.Aciklama) ? "-" : h.Aciklama)</td>
                            <td><span class="badge bg-secondary">@h.SureDakika dk</span></td>
                            <td class="fw-semibold">@h.Ucret.ToString("N2") TL</td>
                            <td>@h.Hekimler.Count hekim</td>
                            <td class="text-end">
                                <a asp-action="Detay" asp-route-id="@h.Id" class="btn btn-sm btn-outline-secondary">Detay</a>
                                <a asp-action="Duzenle" asp-route-id="@h.Id" class="btn btn-sm btn-outline-primary">Düzenle</a>
                                <a asp-action="Sil" asp-route-id="@h.Id" class="btn btn-sm btn-outline-danger">Sil</a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
