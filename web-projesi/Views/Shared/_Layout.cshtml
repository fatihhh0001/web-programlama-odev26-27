<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Veteriner Kliniği Takip Sistemi</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/web_projesi.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-success border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
                    Pati Veteriner Kliniği
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#anaMenu"
                        aria-controls="anaMenu" aria-expanded="false" aria-label="Menüyü Aç">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-lg-inline-flex justify-content-between" id="anaMenu">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Home" asp-action="Index">Ana Sayfa</a>
                        </li>

                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-white" asp-controller="Hizmet" asp-action="Index">Hizmet Yönetimi</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-white" asp-controller="Hekim" asp-action="Index">Hekim Yönetimi</a>
                                </li>
                            }

                            <li class="nav-item">
                                <a class="nav-link text-white" asp-controller="EvcilHayvan" asp-action="Index">
                                    @(User.IsInRole("Uye") ? "Evcil Hayvanlarım" : "Hasta Hayvanlar")
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-controller="Randevu" asp-action="Index">
                                    @(User.IsInRole("Uye") ? "Randevularım" : "Randevu Yönetimi")
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-controller="AsiKaydi" asp-action="Index">Aşı Takvimi</a>
                            </li>

                            @if (User.IsInRole("Admin") || User.IsInRole("Veteriner"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-white" asp-controller="Rapor" asp-action="Index">API Raporları</a>
                                </li>
                            }
                        }
                    </ul>

                    <ul class="navbar-nav align-items-center">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item me-2">
                                <span class="badge bg-light text-success">
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <text>Admin</text>
                                    }
                                    else if (User.IsInRole("Veteriner"))
                                    {
                                        <text>Veteriner</text>
                                    }
                                    else
                                    {
                                        <text>Üye</text>
                                    }
                                </span>
                                <span class="text-white small ms-1">@User.Identity.Name</span>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Hesap" asp-action="Cikis" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-light">Çıkış Yap</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item me-2">
                                <a class="btn btn-sm btn-outline-light" asp-controller="Hesap" asp-action="Giris">Giriş Yap</a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-sm btn-light text-success fw-semibold" asp-controller="Hesap" asp-action="Kayit">Üye Ol</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        @if (TempData["BilgiMesaji"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["BilgiMesaji"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
            </div>
        }
        @if (TempData["HataMesaji"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @TempData["HataMesaji"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
            </div>
        }

        <main role="main" class="pb-4">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted py-3 mt-4">
        <div class="container d-flex justify-content-between small">
            <span>&copy; 2026 - Pati Veteriner Kliniği Randevu ve Hasta Takip Sistemi</span>
            <span>Çalışma Saatlerimiz: Hafta İçi ve Cumartesi 09:00 - 18:00</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
