@model GirisModeli
@{
    ViewData["Title"] = "Sisteme Giriş";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-5">
        <div class="card shadow-sm">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0">Kullanıcı Girişi</h5>
            </div>
            <div class="card-body">
                <form asp-action="Giris" asp-controller="Hesap" method="post">
                    <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Eposta" class="form-label fw-semibold"></label>
                        <input asp-for="Eposta" class="form-control" placeholder="ornek@sakarya.edu.tr" />
                        <span asp-validation-for="Eposta" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Sifre" class="form-label fw-semibold"></label>
                        <input asp-for="Sifre" class="form-control" placeholder="Şifreniz" />
                        <span asp-validation-for="Sifre" class="text-danger small"></span>
                    </div>

                    <div class="mb-3 form-check">
                        <input asp-for="BeniHatirla" class="form-check-input" />
                        <label asp-for="BeniHatirla" class="form-check-label"></label>
                    </div>

                    <button type="submit" class="btn btn-success w-100">Giriş Yap</button>
                </form>

                <hr />
                <div class="text-center">
                    <span>Henüz hesabınız yok mu?</span>
                    <a asp-action="Kayit" asp-controller="Hesap" class="fw-semibold text-success">Yeni Üye Kaydı Oluştur</a>
                </div>
            </div>
        </div>

        <div class="card mt-3 border-secondary">
            <div class="card-body py-2 small text-muted">
                <strong>Test Hesapları (Şifre: sau):</strong>
                <ul class="mb-0 mt-1">
                    <li><strong>Admin:</strong> g231210007@sakarya.edu.tr</li>
                    <li><strong>Veteriner:</strong> vet1@ornek.com / vet2@ornek.com</li>
                    <li><strong>Üye (Hayvan Sahibi):</strong> uye1@ornek.com</li>
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
